# Report every failure through the not found message so that find_package
# handles it according to the REQUIRED and QUIET options of the consumer.
if (CMAKE_VERSION VERSION_LESS @ng-log_CMake_VERSION@)
  set (ng-log_FOUND FALSE)
  set (ng-log_NOT_FOUND_MESSAGE "ng-log requires CMake \
@ng-log_CMake_VERSION@ or later but CMake ${CMAKE_VERSION} is used.")
  return ()
endif (CMAKE_VERSION VERSION_LESS @ng-log_CMake_VERSION@)

@PACKAGE_INIT@

foreach (_ng-log_COMPONENT IN LISTS ng-log_FIND_COMPONENTS)
  if (ng-log_FIND_REQUIRED_${_ng-log_COMPONENT})
    set (ng-log_FOUND FALSE)
    set (ng-log_NOT_FOUND_MESSAGE "ng-log provides no components but the \
required component ${_ng-log_COMPONENT} was requested.")
    unset (_ng-log_COMPONENT)
    return ()
  endif (ng-log_FIND_REQUIRED_${_ng-log_COMPONENT})
endforeach (_ng-log_COMPONENT)

unset (_ng-log_COMPONENT)

include (CMakeFindDependencyMacro)

# Extending the module path of the consumer would leak the bundled find
# modules into unrelated lookups, and modules of the consumer earlier in the
# path would shadow the bundled ones. Extend the path only within a block.
# find_dependency reports a missing dependency and returns, which leaves the
# block and propagates the result.
block (SCOPE_FOR VARIABLES PROPAGATE ng-log_FOUND ng-log_NOT_FOUND_MESSAGE)
  list (PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")

  find_dependency (Threads)
  @Unwind_DEPENDENCY@
  @Libbacktrace_DEPENDENCY@
endblock ()

include (${CMAKE_CURRENT_LIST_DIR}/ng-log-targets.cmake)
