prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libng-log
Description: C++ logging framework
Version: @VERSION@
Libs: -L${libdir} -l@ng-log_pkgconfig_library@
Libs.private: @ng-log_libraries_options_for_static_linking@
Cflags: -I${includedir} @ng-log_pkgconfig_compile_options@
